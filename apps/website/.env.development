# Loaded by vite in dev only (`pnpm --filter postguard-website dev`), taking
# precedence over `.env`. It exists because `.env` carries
# __VITE_FILEHOST_URL_PLACEHOLDER__, which the prod image's entrypoint
# substitutes at container start — in a local dev run that placeholder would
# reach the SDK verbatim as a bogus upload URL, and requireEnv() cannot catch it
# because it is non-empty. Matches the default documented in README.md.
VITE_FILEHOST_URL="http://localhost:8000"
